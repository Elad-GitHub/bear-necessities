{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "https://api.bearnecessities.app",
    "Audience": "https://bearnecessities.app",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Storage": {
    "Provider": "R2",
    "BucketName": "nomadica-media",
    "AccountId": "your-r2-account-id",
    "AccessKey": "your-r2-access-key",
    "SecretKey": "your-r2-secret-key",
    "CdnBaseUrl": "https://media.bearnecessities.app",
    "PresignedUrlExpiryMinutes": 15,
    "MaxFileSizeBytes": 10485760,
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
